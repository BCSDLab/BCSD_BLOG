---
import Base from './Base.astro';
import PostListItem from '../components/PostListItem.astro';
import type { ListPost } from '../lib/posts';
interface Props {
  title: string;
  description: string;
  posts: ListPost[];
  active?: string;
}
const { title, description, posts } = Astro.props;
---

<Base title={title} description={description}>
  <section class="page-width listing-page">
    <div class="page-heading">
      <h1>
        {title}
        <span class="count">{posts.length}</span>
      </h1>
      <p>{description}</p>
    </div>
    {posts.length ? (
      <div class="post-list">
        {posts.map((post) => (
          <PostListItem post={post} />
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <h2>아직 등록된 글이 없습니다.</h2>
        <p>글을 작성하려면 가이드를 확인해주세요.</p>
        <a class="text-link" href="/guideline">
          작성 가이드 보기 →
        </a>
      </div>
    )}
    <slot />
  </section>
</Base>
