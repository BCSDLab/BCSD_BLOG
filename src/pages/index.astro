---
import Base from '../layouts/Base.astro';
import PostListItem from '../components/PostListItem.astro';
import { listPosts, postUrl, sectionOf } from '../lib/posts';
const articles = await listPosts();
const featured = articles.filter((post) => post.data.featured).slice(0, 3);
---

<Base>
  <div class="page-width home-page">
    <header class="home-heading">
      <h1>BCSD 기술 블로그</h1>
      <p>프로젝트를 만들며 겪은 문제와 해결 과정을 기록합니다.</p>
    </header>
    <div class="home-layout">
      <section id="latest" class="latest-posts" aria-labelledby="latest-title">
        <div class="list-heading">
          <h2 id="latest-title">최근 글</h2>
          <a href="/blog" aria-label="전체 글 보기">
            전체
          </a>
        </div>
        <div class="post-list">
          {articles.slice(0, 5).map((post) => (
            <PostListItem post={post} />
          ))}
        </div>
      </section>
      <aside class="home-info">
        <section class="about-blog" aria-labelledby="about-title">
          <h2 id="about-title">BCSD</h2>
          <p>
            한국기술교육대학교 IT 동아리입니다. 개발, 디자인, 기획 등 여러
            분야의 구성원이 서비스와 프로젝트를 함께 만듭니다.
          </p>
          <a href="/introduce/what-is-bcsd">
            동아리 소개 <span aria-hidden="true">→</span>
          </a>
        </section>
        {featured.length > 0 && (
          <section class="sidebar-section">
            <h2>추천 글</h2>
            <ul class="featured-links">
              {featured.map((post) => (
                <li>
                  <a href={postUrl(post)}>{post.data.title}</a>
                  <span>{sectionOf(post).label}</span>
                </li>
              ))}
            </ul>
          </section>
        )}
        <section class="sidebar-section contributor-note">
          <h2>글 기고하기</h2>
          <p>
            스터디 기록이나 프로젝트 회고를 남기고 싶다면 작성 가이드를
            확인해주세요.
          </p>
          <a href="/guideline">
            작성 가이드 <span aria-hidden="true">→</span>
          </a>
        </section>
      </aside>
    </div>
  </div>
</Base>
