---
interface Props {
  url: string;
  controls?: boolean;
  playing?: boolean;
  loop?: boolean;
  style?: Record<string, string>;
  width?: string | number;
  height?: string | number;
}
const {
  url,
  controls = true,
  loop = false,
  playing = false,
  style,
  width = '100%',
} = Astro.props;
---

<video
  src={url}
  controls={controls}
  loop={loop}
  autoplay={playing}
  muted={playing}
  playsinline
  preload="metadata"
  style={{
    ...style,
    width: typeof width === 'number' ? `${width}px` : width,
    height: 'auto',
  }}
>
  동영상을 재생할 수 없습니다. <a href={url}>동영상 다운로드</a>
</video>
